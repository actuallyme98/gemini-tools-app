# Development: Vite forwards /api to the Nest API.
VITE_API_PROXY_TARGET=http://localhost:5177
# Production with same-origin reverse proxy: leave empty.
VITE_API_BASE_URL=
# For separate frontend/API hosts, set the API origin without /api.
# Production CI sets this Docker build argument for https://tools.lcgmedia.uk:
# VITE_API_BASE_URL=https://api.lcgmedia.uk
# Google sign-in Client ID and allowed domains are fetched from /api/agent/auth/status.
# Configure GOOGLE_CLIENT_ID and GOOGLE_ALLOWED_DOMAINS in the API environment only.
